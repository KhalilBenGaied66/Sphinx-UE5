		{
			"Name": "NNERuntimeORT",
			"Enabled": true
		}
	],
	"Modules": [
		{
			"Name": "SpeechRecognition",
			"Type": "Runtime",
			"LoadingPhase": "PreDefault",
			"PlatformAllowList": [
				"Win64"
			]
		}
	]
